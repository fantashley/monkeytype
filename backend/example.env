DB_NAME=monkeytype
DOCKER_SERVER_PORT=5005
# Address the server listens on, defaults to all interfaces
# HOST=127.0.0.1
DOCKER_DB_PORT=27017
DB_URI=mongodb://localhost:27017
DOCKER_REDIS_PORT=6379
REDIS_URI=redis://localhost:6379
LOG_FOLDER_PATH=./logs/
# Default log file max size is 10 MB
LOG_FILE_MAX_SIZE=10485760
# Path of the backend configuration file, defaults to backend-configuration.json
# next to the compiled server
# BACKEND_CONFIGURATION_PATH=
MODE=dev
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# Set to true to accept requests without a captcha, e.g. for private instances
# CAPTCHA_DISABLED=true
# You can also use the format mongodb://username:password@host:port or
# uncomment the following lines if you want to define them separately
# DB_USERNAME=
# DB_PASSWORD=
# DB_AUTH_MECHANISM="SCRAM-SHA-256"
# DB_AUTH_SOURCE=admin

# You can get a testing email address over at
# https://ethereal.email/create
#
# EMAIL_PORT=587
# EMAIL_HOST=smtp.ethereal.email
# EMAIL_USER=
# EMAIL_PASS=

# Authentication provider, "firebase" (default) or "oidc".
# With "oidc", user accounts are managed by an external OpenID Connect provider
# and the frontend needs to be built with the same provider settings.
# AUTH_PROVIDER=oidc
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
